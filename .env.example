# ─────────────────────────────────────────────────────────
#  EJEMPLO DE VARIABLES DE ENTORNO – Sports API
#  Copia este archivo como ".env" y rellena tus valores.
#  NUNCA subas el archivo ".env" a GitHub.
# ─────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Desactiva el hot-reload en producción
RELOAD=True

# ── Caché (segundos) ──────────────────────────────────────
CACHE_TTL_SECONDS=60

# ── Seguridad ─────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma)
# En producción reemplaza "*" con tu dominio real:
# ALLOWED_ORIGINS=https://tusitio.com,https://app.tusitio.com
ALLOWED_ORIGINS=*

# ── HTTP cliente ──────────────────────────────────────────
HTTP_TIMEOUT=8.0

# ── (Opcional) Si en el futuro agregas una API Key propia ─
# SPORTS_API_KEY=tu_api_key_aqui
# DATABASE_URL=postgresql://usuario:password@localhost/sports_db
# SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria

